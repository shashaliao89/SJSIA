PORT=4000

# 使用 docker compose up -d 後可直接套用此連線字串
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sjsia_portal

JWT_SECRET=change-me-in-production-use-long-random-string

# 允許的前端來源（逗號分隔）。本機 Portal + 正式 Portal 網域
CORS_ORIGIN=http://localhost:3001,https://portal.sjsia.org

# Google Sheets 會員名單唯讀同步
GOOGLE_SHEET_ID=1WPK49aS2cWfGjT56HUJHjRwKhFFrnx0bFgkBl1ZFnRA
GOOGLE_SHEET_NAME=會員名單_整理
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Railway Variables 中可貼原始多行 private key，或使用 \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 會員註冊驗證碼／忘記密碼寄信（Railway Hobby 請使用 Resend HTTPS API）
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=member@sjsia.org

# SMTP 備援（僅 Railway Pro 以上可使用）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-app-password

# 預設管理員（db:seed 使用）
ADMIN_EMAIL=admin@sjsia.tw
ADMIN_PASSWORD=admin123456
